{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"scripts/**",
				"package.json",
				"tsup.config.ts",
				"tsconfig.json"
			],
			"outputs": [
				"dist/**"
			]
		},
		"docs#build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"scripts/**",
				"package.json",
				"tsup.config.ts",
				"tsconfig.json",
				"../../registry/**",
				"next.config.ts",
				"postcss.config.mjs"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**"
			]
		},
		"@hex-core/cli#build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"scripts/**",
				"package.json",
				"tsup.config.ts",
				"tsconfig.json",
				"../../registry/**",
				"../../skills/**"
			],
			"outputs": [
				"dist/**"
			]
		},
		"@hex-core/payload#build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**",
				"scripts/**",
				"package.json",
				"tsup.config.ts",
				"tsconfig.json",
				"../../registry/**",
				"../../skills/**"
			],
			"outputs": [
				"dist/**"
			]
		},
		"build:registry": {
			"dependsOn": [
				"@hex-core/components#build",
				"@hex-core/tokens#build",
				"@hex-core/registry#build",
				"@hex-core/motion#build"
			],
			"outputs": [
				"registry/**"
			]
		},
		"validate": {
			"dependsOn": [
				"build:registry"
			]
		},
		"test": {
			"dependsOn": [
				"build"
			],
			"inputs": [
				"src/**",
				"test/**",
				"vitest.config.ts",
				"vitest.setup.ts",
				"package.json"
			],
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"lint": {}
	}
}
