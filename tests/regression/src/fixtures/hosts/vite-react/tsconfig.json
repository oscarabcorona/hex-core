{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*"]
}
