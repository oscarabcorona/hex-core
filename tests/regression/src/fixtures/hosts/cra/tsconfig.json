{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src"]
}
