{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["node"]
	},
	"include": ["src/runners/**/*", "src/use-cases/**/*", "scripts/**/*"],
	"exclude": ["src/fixtures/**", "node_modules"]
}
