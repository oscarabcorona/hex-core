{
	"name": "hex-core",
	"private": true,
	"type": "module",
	"description": "AI-native component library for LLMs and humans",
	"scripts": {
		"build": "turbo build",
		"build:barrels": "tsx scripts/build-barrels.ts",
		"build:tokens": "tsx scripts/build-tokens.ts",
		"build:registry": "tsx scripts/build-registry.ts && tsx scripts/build-graph.ts",
		"a11y-audit": "tsx scripts/a11y-audit.ts",
		"audit:tokens": "tsx scripts/audit-tokens.ts",
		"verify:schema-quality": "tsx scripts/verify-schema-quality.ts",
		"regression": "pnpm build && pnpm run build:registry && pnpm a11y-audit && pnpm --filter docs test:visual",
		"regression:use-cases": "pnpm --filter @hex-core/regression regression",
		"regression:full": "pnpm regression && pnpm regression:use-cases",
		"validate": "turbo validate",
		"test": "turbo test",
		"lint": "eslint . && turbo lint",
		"lint:fix": "eslint . --fix && turbo lint -- --fix",
		"format": "prettier --write .",
		"clean": "turbo clean",
		"changeset": "changeset",
		"version": "changeset version && pnpm install --lockfile-only",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@hex-core/registry": "workspace:^",
		"@hex-core/tokens": "workspace:^",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^63.0.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"gpt-tokenizer": "catalog:",
		"jsdom": "catalog:",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"tsx": "catalog:",
		"turbo": "^2.3.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.61.1",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"react": "19.2.5",
			"react-dom": "19.2.5",
			"react-hook-form": "^7.78.0",
			"@radix-ui/react-dialog": "^1.1.17"
		}
	}
}
