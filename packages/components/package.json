{
	"name": "@hex-core/components",
	"version": "1.9.0",
	"description": "AI-native React components for Hex Core — Radix UI + Tailwind CSS with machine-readable schemas. RSC-aware per-component bundles + tree-shakable.",
	"keywords": [
		"react",
		"components",
		"radix-ui",
		"tailwind",
		"mcp",
		"ai-native",
		"component-library",
		"hex-core"
	],
	"license": "MIT",
	"author": "Oscar Corona <oabc4004@gmail.com>",
	"homepage": "https://hex-core.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarabcorona/hex-core.git",
		"directory": "packages/components"
	},
	"bugs": {
		"url": "https://github.com/oscarabcorona/hex-core/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./tailwind.css": "./tailwind.css",
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"tailwind.css",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && node scripts/inject-use-client.mjs",
		"clean": "rm -rf dist",
		"audit:use-client": "node scripts/audit-use-client.mjs",
		"prepack": "pnpm run build",
		"test": "vitest run"
	},
