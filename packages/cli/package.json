{
	"name": "@hex-core/cli",
	"version": "0.8.0",
	"description": "CLI for Hex Core — copy components into your project with one command.",
	"keywords": [
		"hex-core",
		"cli",
		"component-library",
		"scaffolding",
		"shadcn-alternative"
	],
	"license": "MIT",
	"author": "Oscar Corona <oabc4004@gmail.com>",
	"homepage": "https://hex-core.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarabcorona/hex-core.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/oscarabcorona/hex-core/issues"
	},
	"type": "module",
	"bin": {
		"hex": "dist/index.js"
	},
	"files": [
		"dist",
		"registry",
		"skills",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prebuild": "rm -rf skills registry && cp -R ../../skills ./skills && cp -R ../../registry ./registry",
		"build": "tsup",
		"dev": "tsx src/index.ts",
		"clean": "rm -rf dist skills registry",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@hex-core/registry": "workspace:^",
		"@hex-core/themes": "workspace:^",
		"@hex-core/tokens": "workspace:^",
		"@inquirer/prompts": "^8.4.2",
		"commander": "^14.0.3",
		"culori": "^4.0.2",
		"picocolors": "^1.1.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/culori": "^4.0.1",
		"@types/node": "^25.6.0",
		"tsup": "^8.3.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3"
	}
}
