{
	"name": "@hex-core/mcp",
	"version": "0.6.2",
	"description": "Universal MCP server for Hex Core — runs on Claude Code, Cursor, Continue, Gemini CLI, ChatGPT Desktop, and Zed. 13 tools over the component registry. Thin transport shell — pure-function builders live in @hex-core/payload.",
	"keywords": [
		"hex-core",
		"mcp",
		"model-context-protocol",
		"mcp-client-agnostic",
		"ai-native",
		"component-library"
	],
	"license": "MIT",
	"author": "Oscar Corona <oabc4004@gmail.com>",
	"homepage": "https://hex-core.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarabcorona/hex-core.git",
		"directory": "packages/mcp-server"
	},
	"bugs": {
		"url": "https://github.com/oscarabcorona/hex-core/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"hex-core-mcp": "dist/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js"
		},
		"./clients": {
			"types": "./dist/clients.d.ts",
			"import": "./dist/clients.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "tsup && pnpm build:readme",
		"build:readme": "node scripts/build-readme.mjs",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"test:contract": "node dist/contract-test.js",
		"test": "pnpm test:contract",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@hex-core/payload": "workspace:^",
		"@hex-core/registry": "workspace:^",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"gpt-tokenizer": "^3.4.0",
		"tsup": "^8.3.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3"
	}
}
