{
	"name": "@hex-core/mcp",
	"version": "0.1.2",
	"description": "MCP server for Hex UI — AI-native component distribution. Ships 12 tools over the registry for Claude Code / Cursor / any MCP client.",
	"keywords": [
		"hex-ui",
		"mcp",
		"model-context-protocol",
		"ai-native",
		"claude-code",
		"cursor"
	],
	"license": "MIT",
	"author": "Oscar Corona <oabc4004@gmail.com>",
	"homepage": "https://hex-core.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarabcorona/hex-core.git",
		"directory": "packages/mcp-server"
	},
	"bugs": {
		"url": "https://github.com/oscarabcorona/hex-core/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"hex-ui-mcp": "dist/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"test:resolver": "tsx src/tools/resolver.test.ts",
		"test:app-context": "tsx src/tools/app-context.test.ts",
		"test": "pnpm test:resolver && pnpm test:app-context",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@hex-core/registry": "workspace:^",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"tsup": "^8.3.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3"
	}
}
